# Local DuckLake stack — credentials & database name.
# Defaults are fine for a local dev box; all ports are published on localhost.

# Postgres (DuckLake catalog)
POSTGRES_DB=ducklake_catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RustFS (S3-compatible object store)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# S3 bucket that holds the DuckLake Parquet data
S3_BUCKET=ducklake

# DuckDB version used by the one-shot seed container.
# Keep this on the same 1.5.x line as the DuckDB JDBC driver DBeaver uses,
# so the DuckLake catalog format matches.
DUCKDB_VERSION=1.5.4
